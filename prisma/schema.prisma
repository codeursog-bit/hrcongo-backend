model CnssDeclaration {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  month Int @db.SmallInt   // 1-12
  year  Int @db.SmallInt

  // Données agrégées de la déclaration
  effectif         Int     @db.SmallInt           // Nombre de salariés déclarés
  masseSalariale   Decimal @db.Decimal(15, 2)     // Masse salariale brute totale

  // Cotisations CNSS
  cotisationSalariale  Decimal @db.Decimal(15, 2) // Part salarié (pension 4%)
  cotisationPatronale  Decimal @db.Decimal(15, 2) // Part employeur (pension 8% + famille 10.03% + AT 2.25%)
  cotisationTotale     Decimal @db.Decimal(15, 2) // Total CNSS = salariale + patronale

  // TUS
  tusCnss  Decimal @db.Decimal(15, 2)             // TUS → CNSS (5.475%)
  tusDgi   Decimal @db.Decimal(15, 2)             // TUS → DGI (2.025%)

  // Montants à verser
  totalAVerserCnss  Decimal @db.Decimal(15, 2)    // cotisationTotale + tusCnss
  totalAVerserDgi   Decimal @db.Decimal(15, 2)    // tusDgi

  // Statut et workflow
  status            CnssDeclarationStatus @default(A_DECLARER)
  declaredAt        DateTime? @db.Timestamptz      // Date effective de dépôt
  paidAt            DateTime? @db.Timestamptz      // Date de paiement
  paymentReference  String?   @db.VarChar(100)     // Référence virement/chèque
  paymentMode       String?   @db.VarChar(50)      // VIREMENT / CHEQUE / GUICHET

  // Pénalités (si retard)
  isLate       Boolean @default(false)
  monthsLate   Int     @default(0) @db.SmallInt
  penaltyAmount Decimal @default(0) @db.Decimal(15, 2)

  // Métadonnées export
  lastExportedAt  DateTime? @db.Timestamptz
  exportedByUser  String?   @db.Uuid
  warnings        String[]  @default([])           // Ex: ["Dupont: N° CNSS manquant"]

  // Qui a déclaré
  declaredBy   String? @db.Uuid
  notes        String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Ligne par salarié (snapshot de la déclaration)
  lines CnssDeclarationLine[]

  @@unique([companyId, month, year])
  @@index([companyId])
  @@index([month, year])
  @@index([status])
  @@map("cnss_declarations")
}

model CnssDeclarationLine {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  declarationId  String          @db.Uuid
  declaration    CnssDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  employeeId     String  @db.Uuid
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeNumber String  @db.VarChar(50)
  employeeName   String  @db.VarChar(200)
  cnssNumber     String? @db.VarChar(50)
  contractType   ContractType

  brutMensuel       Decimal @db.Decimal(15, 2)
  pensionSalarial   Decimal @db.Decimal(15, 2)  // 4% plaf. 1 200 000
  pensionPatronal   Decimal @db.Decimal(15, 2)  // 8% plaf. 1 200 000
  familyPatronal    Decimal @db.Decimal(15, 2)  // 10.03% plaf. 600 000
  accidentPatronal  Decimal @db.Decimal(15, 2)  // 2.25% plaf. 600 000
  totalCnss         Decimal @db.Decimal(15, 2)
  tusCnss           Decimal @db.Decimal(15, 2)
  tusDgi            Decimal @db.Decimal(15, 2)

  @@index([declarationId])
  @@index([employeeId])
  @@map("cnss_declaration_lines")
}

enum CnssDeclarationStatus {
  A_DECLARER    // Bulletins disponibles, déclaration non faite
  DECLAREE      // Déposée à la CNSS (en attente paiement)
  PAYEE         // Payée et quittancée
  EN_RETARD     // Date limite dépassée
  REGULARISEE   // Retard régularisé avec pénalités

  @@map("cnss_declaration_status")
}


// ============================================================================
// 🆕 MODEL 2 : EmployeeContract — Contrat complet avec historique
// (remplace les champs contractType/contractEndDate directement sur Employee)
// ============================================================================

model EmployeeContract {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Type et durée
  contractType  ContractType
  startDate     DateTime  @db.Date
  endDate       DateTime? @db.Date       // null = CDI ou en cours
  duration      Int?      @db.SmallInt   // durée en mois (CDD)
  isRenewable   Boolean   @default(false)
  renewalCount  Int       @default(0) @db.SmallInt

  // Poste et rémunération au moment de signature
  position       String  @db.VarChar(100)
  baseSalary     Decimal @db.Decimal(15, 2)
  departmentId   String  @db.Uuid

  // Période d'essai
  trialPeriodDays  Int?      @db.SmallInt  // durée période essai en jours
  trialEndDate     DateTime? @db.Date
  trialConfirmedAt DateTime? @db.Timestamptz

  // Spécifique PRESTATAIRE / CONSULTANT
  serviceDescription  String?  @db.Text    // Objet de la prestation
  dailyRate           Decimal? @db.Decimal(15, 2)  // TJM si consultant
  invoicingMode       String?  @db.VarChar(50)      // MENSUEL / À_LA_MISSION / FORFAIT

  // Spécifique INTÉRIM
  interimAgency       String?  @db.VarChar(100)
  interimAgencyRef    String?  @db.VarChar(50)

  // Statut
  status  ContractStatus @default(ACTIVE)

  // Document PDF du contrat
  documentUrl  String? @db.Text

  // Métadonnées
  signedAt     DateTime? @db.Timestamptz
  signedByEmp  Boolean   @default(false)  // Contrat signé par l'employé ?
  notes        String?   @db.Text
  createdBy    String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relation rupture de contrat
  rupture ContractRupture?

  @@index([employeeId])
  @@index([companyId])
  @@index([contractType])
  @@index([status])
  @@index([endDate])
  @@map("employee_contracts")
}

enum ContractStatus {
  ACTIVE
  EXPIRED          // CDD arrivé à terme
  TERMINATED       // Rupture anticipée
  TRIAL            // En période d'essai
  TRIAL_FAILED     // Essai non concluant
  CONVERTED        // CDD converti en CDI
  SUSPENDED        // Suspendu (ex: suspension disciplinaire)

  @@map("contract_status")
}


// ============================================================================
// 🆕 MODEL 3 : ContractRupture — Gestion complète de la fin de contrat
// ============================================================================

model ContractRupture {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId String           @unique @db.Uuid
  contract   EmployeeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  employeeId String           @db.Uuid
  employee   Employee         @relation(fields: [employeeId], references: [id]) // <--- AJOUTE CETTE LIGNE PRÉCISEMENT
  companyId  String           @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  // Type et cause de rupture
  ruptureType  RuptureType
  ruptureDate  DateTime    @db.Date              // Date effective de fin
  noticeGiven  DateTime?   @db.Date              // Date de remise du préavis

  // Cause détaillée (obligatoire pour licenciement)
  causeCode    String?     @db.VarChar(50)       // Ex: "FAUTE_GRAVE", "MOTIF_ECONOMIQUE"
  causeLabel   String?     @db.VarChar(255)
  causeDetail  String?     @db.Text              // Description complète

  // Préavis
  noticePeriodDays   Int?     @db.SmallInt       // Durée légale du préavis en jours
  noticeWorked       Boolean  @default(true)     // Préavis effectué ?
  noticeWaived       Boolean  @default(false)    // Préavis dispensé (avec indemnité) ?

  // Ancienneté et calculs
  yearsOfService      Decimal  @db.Decimal(5, 2)  // Années d'ancienneté exactes
  monthsOfService     Int      @db.SmallInt        // Mois d'ancienneté
  lastMonthlyGross    Decimal  @db.Decimal(15, 2)  // Dernier salaire brut de référence
  avgLast3MonthsGross Decimal? @db.Decimal(15, 2)  // Moyenne 3 derniers mois (parfois utilisée)
  //   // ✅ AJOUTS — Convention collective
  conventionCode           String?  @db.VarChar(50)   // "COMMERCE", "BTP"...
  avgLast12MonthsGross     Decimal? @db.Decimal(15, 2) // Base congés art.127 CT
  categorieConventionnelle Int?     @db.SmallInt       // Catégorie numérique 1-11
  indemLicenciementDetail  String?  @db.Text           // Détail barème ex: "2 ans × 30%..."
  indemGratification       Decimal  @default(0) @db.Decimal(15, 2) // Gratification proratisée
  brutImposable            Decimal  @default(0) @db.Decimal(15, 2) // Brut soumis ITS
  indemnitesExonerees      Decimal  @default(0) @db.Decimal(15, 2) // Exonérées ITS (lic + congés)
  alertes                  Json     @default("[]")                  // Alertes calcul

  // ── INDEMNITÉS (conformes Code du Travail Congo) ──────────────────────────
  // Indemnité de licenciement (art. 82 Code Travail Congo)
  //   = ancienneté × taux selon barème
  indemLicenciement      Decimal @default(0) @db.Decimal(15, 2)
  indemLicenciementBase  String? @db.VarChar(100)  // Ex: "1 mois/an pour les 5 premières années"

  // Indemnité compensatrice de préavis (si préavis non effectué)
  indemPreavis           Decimal @default(0) @db.Decimal(15, 2)
  indemPreavisDays       Int     @default(0) @db.SmallInt

  // Indemnité compensatrice de congés payés (congés non pris)
  indemConges            Decimal @default(0) @db.Decimal(15, 2)
  indemCongesDays        Decimal @default(0) @db.Decimal(5, 2)

  // Dernier salaire proratisé (jours travaillés ce mois)
  dernierSalaireProrata  Decimal @default(0) @db.Decimal(15, 2)
  dernierSalaireDays     Int     @default(0) @db.SmallInt

  // Autres sommes dues (primes, remboursements...)
  autresSommesDues       Decimal @default(0) @db.Decimal(15, 2)
  autresSommesDetail     String? @db.Text

  // Total net à payer lors de la rupture
  totalBrut              Decimal @default(0) @db.Decimal(15, 2)
  totalNet               Decimal @default(0) @db.Decimal(15, 2)   // Après déductions éventuelles
  cnssApplicable         Boolean @default(false)  // Indemnités soumises à CNSS ?
  itsApplicable          Boolean @default(false)  // Indemnités soumises à ITS ?

  // ── DOCUMENTS ─────────────────────────────────────────────────────────────
  lettreNotificationUrl  String? @db.Text     // Lettre de licenciement / démission
  conventionRuptureUrl   String? @db.Text     // Convention rupture conventionnelle
  recuSoldeUrl           String? @db.Text     // Reçu pour solde de tout compte

 cnssAttestationUrl  String?   // HTML attestation CNSS stocké
 cnssNotifiedAt      DateTime? // Date envoi effectif à la CNSS
  // ── WORKFLOW ──────────────────────────────────────────────────────────────
  status         RuptureStatus @default(EN_COURS)
  paidAt         DateTime?     @db.Timestamptz
  paymentRef     String?       @db.VarChar(100)

  processedBy    String?  @db.Uuid
  notes          String?  @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([employeeId])
  @@index([companyId])
  @@index([ruptureType])
  @@index([status])
  @@index([ruptureDate])
  @@map("contract_ruptures")
}

enum RuptureType {
  DEMISSION             // Démission (initiative employé)
  LICENCIEMENT_FAUTE_SIMPLE    // Licenciement pour faute simple
  LICENCIEMENT_FAUTE_GRAVE     // Licenciement pour faute grave (pas d'indemnités)
  LICENCIEMENT_FAUTE_LOURDE    // Faute lourde (idem + dommages)
  LICENCIEMENT_ECONOMIQUE      // Motif économique
  RUPTURE_CONVENTIONNELLE      // Rupture d'un commun accord
  FIN_CDD                      // CDD arrivé à terme normalement
  FIN_PERIODE_ESSAI            // Rupture pendant/à la fin de l'essai
  RETRAITE                     // Départ à la retraite
  DECES                        // Décès de l'employé
  FORCE_MAJEURE                // Cas de force majeure
  INVALIDITE                   // Inaptitude / invalidité reconnue

  @@map("rupture_type")
}

enum RuptureStatus {
  EN_COURS        // En cours de traitement
  CALCULE         // Indemnités calculées, en attente validation
  VALIDE          // Validé par RH/Admin
  PAYE            // Solde de tout compte payé
  CONTESTE        // Contesté par l'employé
  ARCHIVE         // Archivé

  @@map("rupture_status")
}

