// ── AJOUTE cet enum DocumentStatus (nouveau) ─────────────────────────────────

enum DocumentStatus {
  PENDING_REVIEW       // Soumis, en attente de vérification RH
  VERIFIED             // Validé par RH
  REJECTED             // Rejeté par RH
  EXPIRED              // Expiré (basculé automatiquement par le cron)

  @@map("document_status")
}

// ── REMPLACE le model Document complet ───────────────────────────────────────

model Document {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Type & identification
  type        DocumentType
  name        String       @db.VarChar(255)
  description String?      @db.Text

  // Fichier — on stocke le publicId Cloudinary (mode authenticated)
  fileUrl  String  @db.Text
  fileSize Int?    @db.Integer
  mimeType String? @db.VarChar(100)

  // Métadonnées du document physique
  documentNumber String?   @db.VarChar(100)
  issuingBody    String?   @db.VarChar(255)
  issuedAt       DateTime? @db.Date
  expiresAt      DateTime? @db.Date

  // Statut & vérification RH
  status          DocumentStatus @default(PENDING_REVIEW)
  rejectionReason String?        @db.Text
  verifiedById    String?        @db.Uuid
  verifiedBy      User?          @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?      @db.Timestamptz

  // Versioning
  version      Int     @default(1) @db.SmallInt
  replacedById String? @db.Uuid
  isArchived   Boolean @default(false)

  // Relations
  employeeId String?   @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  payrollId String?  @unique @db.Uuid
  payroll   Payroll? @relation("PayrollPayslip", fields: [payrollId], references: [id], onDelete: Cascade)

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Traçabilité
  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now()) @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([employeeId])
  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
  @@index([isArchived])
  @@map("documents")
}


model Loan {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  amount           Decimal @db.Decimal(15, 2)
  monthlyRepayment Decimal @db.Decimal(15, 2)
  remainingBalance Decimal @db.Decimal(15, 2)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  status LoanStatus @default(ACTIVE)
  type LoanType @default(ARGENT)

  reason     String?   @db.Text
  approvedBy String?   @db.Uuid
  approvedAt DateTime? @db.Timestamptz
  requestedByUserId String? @db.Uuid
  recoverViaPayroll Boolean @default(true)

drhDecision    ApprovalDecision?
  drhDecidedBy   String?           @db.Uuid
  drhDecidedAt   DateTime?         @db.Timestamptz

  dgDecision     ApprovalDecision?
  dgDecidedBy    String?           @db.Uuid
  dgDecidedAt    DateTime?         @db.Timestamptz

  // Validation désormais PARALLÈLE (DRH et DG reçoivent en même temps, le
  // premier présent valide/refuse) — drhDecision/dgDecision sont donc
  // toujours renseignés ensemble avec la même valeur (conservés pour la
  // fiche imprimable qui a 2 cases de signature). decidedByRole retient la
  // casquette (DRH ou DG) de la personne qui a effectivement tranché, pour
  // affichage/traçabilité dans l'historique.
  decidedByRole  String?           @db.VarChar(10)

  rejectionReason String? @db.Text
  notes String? @db.Text
  printAuthorized       Boolean   @default(false)
  printAuthorizedBy     String?   @db.Uuid
  printAuthorizedByUser User?     @relation("LoanPrintAuthorizedBy", fields: [printAuthorizedBy], references: [id], onDelete: SetNull)
  printAuthorizedAt     DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  
  repaymentLogs LoanRepaymentLog[]
  @@index([employeeId])
  @@index([status])
  @@map("loans")
}

