// ============================================================================
// 💰 PRIMES EMPLOYÉS (MANUEL + AUTO)
// ============================================================================

model EmployeeBonus {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // 🏷️ TYPE DE PRIME
  bonusType  String   @db.VarChar(100)  // "Prime de transport", "Prime d'ancienneté"
  
  // 🔧 MODE DE CALCUL
  calculationType BonusCalculationType @default(FIXED_AMOUNT)
  
  // 💵 VALEURS
  fixedAmount     Decimal? @db.Decimal(15, 2)  // Montant fixe (ex: 20 000 FCFA)
  percentage      Decimal? @db.Decimal(5, 2)   // Pourcentage (ex: 5.00 pour 5%)
  baseCalculation BonusBase? @default(BASE_SALARY)  // BASE_SALARY ou GROSS_SALARY
  
  // 📅 FRÉQUENCE
  frequency BonusFrequency @default(MONTHLY)
  
  // 🤖 ORIGINE
  isAutomatic Boolean @default(false)  // true = calculé par convention, false = manuel
  ruleId      String? @db.Uuid         // Lien vers la règle de convention (si auto)
  
  // 🟢 ACTIVATION
  isActive  Boolean  @default(true)
  startDate DateTime @default(now()) @db.Date
  endDate   DateTime? @db.Date
  
  // 📝 NOTES
  notes String? @db.Text
  
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  
  isTaxable  Boolean @default(true)
  isCnss     Boolean @default(true)
  isProratized       Boolean  @default(false)  // 🆕 Prime réduite si absence
  fiscalType           String?  @db.VarChar(20)
  unitAmount           Decimal? @db.Decimal(15, 2)
  quantityMode         String?  @db.VarChar(20)
  defaultQuantity      Decimal? @db.Decimal(8, 2)
  isInLeaveBase      Boolean  @default(true)   // 🆕 Incluse dans moyenne 12 mois
  bonusCategory      BonusCategory @default(PERFORMANCE) // Catégorie principale

  bonusTemplateId String?        @db.Uuid 

  monthlyQuantities    BonusMonthlyQuantity[]
  bonusTemplate   BonusTemplate? @relation(fields: [bonusTemplateId], references: [id])
  @@index([employeeId])
  @@index([isActive])
  @@index([isAutomatic])
  @@index([frequency])
  @@map("employee_bonuses")
}

// 🔧 Type de calcul
enum BonusCalculationType {
  FIXED_AMOUNT      // Montant fixe (20 000 FCFA)
  PERCENTAGE        // Pourcentage (5% du salaire)
  
  @@map("bonus_calculation_type")
}

// 📊 Base de calcul (pour les pourcentages)
enum BonusBase {
  BASE_SALARY       // Salaire de base
  GROSS_SALARY      // Salaire brut
  
  @@map("bonus_base")
}

// 📅 Fréquence de la prime
enum BonusFrequency {
  MONTHLY           // Chaque mois
  ANNUAL            // Une fois par an (ex: 13ème mois)
  ONE_TIME          // Une seule fois (prime exceptionnelle)
  
  @@map("bonus_frequency")
}
 enum BonusCategory {
    FRAIS              // Indemnité représentative de frais (transport, panier, logement)
    POSTE              // Liée au poste/ancienneté/diplôme — maintenue à 100%
    PERFORMANCE        // Liée à présence/rendement — proratisable
    EXCEPTIONNELLE     // Ponctuelle (13e mois, prime résultat annuel)

    @@map("bonus_category")
 }
// ============================================================================
// 🤖 RÈGLES DES CONVENTIONS COLLECTIVES (AUTO)
// ============================================================================

model CollectiveAgreementRule {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // 🏷️ CONVENTION
  agreementCode String @db.VarChar(50)  // "BTP", "COMMERCE", "BANQUES"
  
  // 🎯 TYPE DE RÈGLE
  ruleType CollectiveAgreementRuleType
  
  // 📋 CATÉGORIE CONCERNÉE (optionnel)
  professionalCategory String? @db.VarChar(50)  // "Cat.3 Éch.4", "A1" (null = toutes)
  
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // RÈGLE: SALAIRE MINIMUM
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  minimumSalary Decimal? @db.Decimal(15, 2)
  
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // RÈGLE: PRIME AUTOMATIQUE
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  bonusType           String?  @db.VarChar(100)  // "Prime d'ancienneté"
  minMonthsOfService  Int?     @db.SmallInt      // Ex: 24 mois = 2 ans
  maxMonthsOfService  Int?     @db.SmallInt      // Ex: 60 mois = 5 ans (plafond)
  bonusPercentage     Decimal? @db.Decimal(5, 2) // Ex: 5.00 pour 5%
  bonusFixedAmount    Decimal? @db.Decimal(15, 2)
  bonusBaseCalculation BonusBase? @default(BASE_SALARY)
  
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // RÈGLE: CONGÉS SUPPLÉMENTAIRES
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  additionalLeaveDays Int? @db.SmallInt
  
  // 🟢 ACTIVATION
  isActive Boolean @default(true)
  
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  
  @@index([companyId])
  @@index([agreementCode])
  @@index([ruleType])
  @@index([professionalCategory])
  @@index([isActive])
  @@map("collective_agreement_rules")
}

// 🎯 Types de règles possibles
enum CollectiveAgreementRuleType {
  MINIMUM_SALARY          // Salaire minimum par catégorie
  AUTOMATIC_BONUS         // Prime automatique (ancienneté, transport...)
  ADDITIONAL_LEAVE        // Jours de congé supplémentaires
  OVERTIME_RATE           // Taux heures sup personnalisé
  
  @@map("collective_agreement_rule_type")
}
