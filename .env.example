
# Connecteur Compta : activer uniquement après migration et génération Prisma.
KONZA_COMPTA_API_URL=http://localhost:4000
KONZA_COMPTA_CONNECTOR_ENABLED=false

# Assistant: backend only, never NEXT_PUBLIC. Choose openai | anthropic | google | mistral
ASSISTANT_PROVIDER=mistral
# Exact model ID available in your provider account
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
