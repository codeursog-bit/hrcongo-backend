// ============================================================================
// 🆕 MODEL 4 : UnpaidSalaryAlert — Suivi salaires impayés
// ============================================================================

model UnpaidSalaryAlert {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Période non payée
  month Int @db.SmallInt
  year  Int @db.SmallInt

  // Montants
  totalNetDu      Decimal @db.Decimal(15, 2)   // Total net à payer ce mois
  employeeCount   Int     @db.SmallInt          // Nombre d'employés concernés

  // Statut
  status          UnpaidStatus @default(EN_ATTENTE)
  daysOverdue     Int          @default(0) @db.SmallInt  // Jours de retard
  
  // Alerte envoyée
  alertSentAt     DateTime? @db.Timestamptz
  alertLevel      Int       @default(1) @db.SmallInt  // 1=info, 2=warn, 3=urgent

  // Régularisation
  partiallyPaidAt DateTime? @db.Timestamptz
  partialAmount   Decimal?  @db.Decimal(15, 2)
  fullyPaidAt     DateTime? @db.Timestamptz
  notes           String?   @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([companyId, month, year])
  @@index([companyId])
  @@index([status])
  @@map("unpaid_salary_alerts")
}

enum UnpaidStatus {
  EN_ATTENTE        // Bulletin généré, pas encore payé
  PAIEMENT_PARTIEL  // Paiement partiel reçu
  PAYE              // Entièrement payé
  EN_LITIGE         // Contesté / litige

  @@map("unpaid_status")
}




