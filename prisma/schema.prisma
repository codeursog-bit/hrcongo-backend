    label    String  @db.VarChar(150) // "Pharmacie", "Cantine", "Casse matériel"... libre
  amount   Decimal @db.Decimal(15, 2) // montant total dû, fixé à la création — ne change jamais

  // ✅ NOUVEAU — solde restant réellement dû, décrémenté à chaque règlement
  // (espèces ou paie). Initialisé à `amount` à la création.
  remainingBalance Decimal @db.Decimal(15, 2)

  // ✅ NOUVEAU — montant que la paie retire à CHAQUE génération tant qu'il
  // reste un solde (comme la mensualité d'un prêt). Si null : tout le solde
  // restant part en une fois à la prochaine paie.
  monthlyDeduction Decimal? @db.Decimal(15, 2)

  month Int @db.SmallInt // référence de création — la paie ne filtre plus dessus
  year  Int @db.SmallInt

  recoverViaPayroll Boolean @default(true)
  status CompanyDeductionStatus @default(PENDING)

  recordedBy String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  repaymentLogs CompanyDeductionRepaymentLog[]
  @@index([employeeId])
  @@index([companyId, month, year])
  @@map("company_deductions")
}

