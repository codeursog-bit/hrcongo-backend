model WorkShift {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String  @db.Uuid
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String  @db.VarChar(100)   // "Matin", "Soir", "Nuit", "Garde"
  startHour       Int     @db.SmallInt        // 8
  startMinute     Int     @default(0) @db.SmallInt
  endHour         Int     @db.SmallInt        // 16
  endMinute       Int     @default(0) @db.SmallInt
  durationHours   Decimal @db.Decimal(4, 2)   // calculé : 8.0

  crossesMidnight Boolean @default(false)     // true pour 20h→6h
  isNightShift    Boolean @default(false)
  nightPremiumRate Decimal @default(0) @db.Decimal(5, 2) // % prime nuit

  color           String  @default("#0EA5E9") @db.Char(7)
  isDefault       Boolean @default(false)    // Shift par défaut de l'entreprise
  isActive        Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  assignments EmployeeShiftAssignment[]

  @@index([companyId])
  @@index([isActive])
  @@map("work_shifts")
}

model EmployeeShiftAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)  // ← AJOUTER
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String   @db.Uuid
  shift      WorkShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  // Assignation sur une date précise OU un jour récurrent
  specificDate  String?  @db.VarChar(10)   // "2025-07-14" si date unique
  dayOfWeek     Int?     @db.SmallInt      // 0-6 si planning récurrent (null = spécifique)

  // Validité du planning récurrent
  validFrom    DateTime? @db.Date
  validUntil   DateTime? @db.Date

  notes        String?   @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([employeeId, specificDate])
  @@index([employeeId])
  @@index([companyId])
  @@index([shiftId])
  @@index([specificDate])
  @@map("employee_shift_assignments")
}

