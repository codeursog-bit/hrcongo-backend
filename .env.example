# ============================================
# 🇨🇬 HR CONGO - CONFIGURATION
# ============================================

# ============================================
# 🗄️ DATABASE
# ============================================
# SQLite (développement)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production recommandé)
# DATABASE_URL="postgresql://user:password@localhost:5432/hr_congo?schema=public"

# ============================================
# 🔐 SÉCURITÉ
# ============================================
# IMPORTANT: Générer avec: openssl rand -base64 32
JWT_SECRET="votre_cle_secrete_minimum_32_caracteres_ici_changez_moi"

# Durée de validité du token (7d = 7 jours)
JWT_EXPIRATION="7d"

# Clé de chiffrement (optionnel, utilise JWT_SECRET si absent)
ENCRYPTION_KEY="votre_cle_de_chiffrement_changez_moi"

# ============================================
# 🌐 SERVEUR
# ============================================
PORT=3001
NODE_ENV="development"  # development | production | test

# URL du frontend pour CORS
FRONTEND_URL="http://localhost:3000"

# ============================================
# 📧 EMAIL (Optionnel - pour notifications)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="votre_email@gmail.com"
SMTP_PASSWORD="votre_mot_de_passe_app"
SMTP_FROM="noreply@hrcongo.com"

# ============================================
# ⚡ PERFORMANCE
# ============================================
# Nombre max d'employés pour génération batch
MAX_EMPLOYEES_BATCH=500

# Durée du cache pour rapports (secondes)
PAYROLL_CACHE_TTL=300

# ============================================
# 🧪 VARIABLES DE TEST (optionnel)
# ============================================
# DATABASE_URL_TEST="file:./test.db"

# ============================================
# 📝 NOTES
# ============================================
# 1. Copier ce fichier en .env
# 2. Remplacer TOUTES les valeurs "changez_moi"
# 3. Ne JAMAIS committer le fichier .env
# 4. En production, utiliser des secrets managers (AWS Secrets, etc.)
# 
# Génération de clés sécurisées:
# - Linux/Mac: openssl rand -base64 32
# - Node: require('crypto').randomBytes(32).toString('base64')
# ============================================