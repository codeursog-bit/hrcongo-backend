model Affiliate {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String  @db.VarChar(100)
  lastName  String  @db.VarChar(100)
  email     String  @unique @db.VarChar(255)
  password  String  @db.VarChar(255)

  // Code unique qui compose le lien : /?ref=CODE
  referralCode String @unique @db.VarChar(50)
  phone             String?  @db.VarChar(20)
  disbursementPhone String?  @db.VarChar(20)

  // % de commission fixé par le super-admin (ex: 10.00 = 10%)
  commissionRate Decimal @default(10) @db.Decimal(5, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  cabinets    Cabinet[]           @relation("AffiliateCabinets")
  companies   Company[]           @relation("AffiliateCompanies")
  mappings    AffiliateCompany[]
  commissions AffiliateCommission[]
  cabinetMappings    AffiliateCabinet[]
  cabinetCommissions AffiliateCabinetCommission[]
  withdrawalRequests AffiliateWithdrawalRequest[]

  @@index([referralCode])
  @@index([email])
  @@map("affiliates")
}

// Table pivot optionnelle — permet d'avoir des métadonnées sur le lien affilié→entreprise
model AffiliateCompany {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliateId String    @db.Uuid
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  companyId   String    @unique @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Date à laquelle l'entreprise s'est inscrite via le lien
  linkedAt  DateTime @default(now()) @db.Timestamptz

  @@index([affiliateId])
  @@map("affiliate_companies")
}

// Une ligne par paiement RÉUSSI — commission calculée au moment du paiement
model AffiliateCommission {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliateId String    @db.Uuid
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  paymentId   String  @unique @db.Uuid
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // Snapshot au moment du paiement
  companyId      String  @db.Uuid
  paymentAmount  Int     // montant du paiement en XAF (centimes si besoin)
  commissionRate Decimal @db.Decimal(5, 2) // taux appliqué ce jour-là
  commissionAmount Int   // = floor(paymentAmount * commissionRate / 100)

  status AffiliateCommissionStatus @default(PENDING)

  // Pour la future fonctionnalité de versement
  paidAt       DateTime? @db.Timestamptz
  paymentRef   String?   @db.VarChar(100)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([affiliateId])
  @@index([companyId])
  @@index([status])
  @@map("affiliate_commissions")
}

enum AffiliateCommissionStatus {
  PENDING   // Commission calculée, versement à venir
  PAID      // Versée
  CANCELLED // Annulée (ex: remboursement)

  @@map("affiliate_commission_status")
}
model AffiliateCabinet {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
