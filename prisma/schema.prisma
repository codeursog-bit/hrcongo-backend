// ============================================================================
// 🐘 SCHEMA PRISMA - POSTGRESQL PRODUCTION (NEON.TECH)
// ============================================================================
// 
// ✅ Optimisé pour PostgreSQL (pas SQLite)
// ✅ Indexes stratégiques pour performances
// ✅ Contraintes d'intégrité robustes
// ✅ Types natifs PostgreSQL
// ✅ Prêt pour scalabilité
// ✅ Compatible Neon.tech (serverless Postgres)
//
// 🔥 CONFORME FISCALITÉ CONGO 2025-2026
// - IRPP/ITS avec abattement 20%
// - Quotient familial (parts fiscales)
// - CNSS 4% salariale / 16% patronale
//
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // url        = env("DATABASE_URL_UNPOOLED") // ✅ Pour Prisma CLI
  // directUrl  = env("DATABASE_URL_UNPOOLED") // ✅ Décommentez
  url        = env("DATABASE_URL") // Utilise le pooler pour l'app
  directUrl  = env("DATABASE_URL_UNPOOLED") // Utilise la connexion directe pour les migrations
  extensions = [pgcrypto]
}

// ============================================================================
// 1️⃣ AUTHENTIFICATION & UTILISATEURS
// ============================================================================

model User {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String @unique @db.VarChar(255)
  password  String @db.VarChar(255)
  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)

  role     UserRole @default(EMPLOYEE)
  isActive Boolean  @default(true)
  canRecordAttendanceForAll Boolean @default(false)
 

  
// 2FA
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?  @db.VarChar(255)
  twoFactorBackupCodes String[] @default([])      // ← AJOUTER

  // Sécurité
  lastLoginAt            DateTime? @db.Timestamptz
  lastLoginIp            String?   @db.Inet
  passwordChangedAt      DateTime  @default(now()) @db.Timestamptz
  mustChangePassword     Boolean   @default(false)
  firstLoginAt           DateTime? @db.Timestamptz
  failedLoginAttempts    Int       @default(0)     // ← AJOUTER
  lockedUntil            DateTime? @db.Timestamptz // ← AJOUTER

  // Relations
  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String?   @unique @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
 
  // Timestamps
  pushToken                String?  @db.Text
  pushNotifEnabled         Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  createdBy String?  @db.Uuid

  // Relations inversées
  cabinetUsers CabinetUser[]
  activityLogs ActivityLog[]
  sessions     UserSession[]  // ← AJOUTER
  notifications       Notification[]
  createdEmployees    Employee[]             @relation("EmployeeCreatedBy")
  createdPayrolls     Payroll[]              @relation("PayrollCreatedBy")
  validatedPayrolls   Payroll[]              @relation("PayrollValidatedBy")
  approvedLeaves      Leave[]                @relation("LeaveApprovedBy")
  rejectedLeaves      Leave[]                @relation("LeaveRejectedBy")
  absenceRequestsReviewed AbsenceRequest[] @relation("AbsenceReviewedBy")
  leavePrintAuthorized   Leave[]          @relation("LeavePrintAuthorizedBy")
  absencePrintAuthorized AbsenceRequest[] @relation("AbsencePrintAuthorizedBy")
  loanPrintAuthorized    Loan[]           @relation("LoanPrintAuthorizedBy")
  advancePrintAuthorized Advance[]        @relation("AdvancePrintAuthorizedBy")
  permissionsCreated  PermissionTicket[] @relation("PermissionCreatedBy")
  permissionsReviewed PermissionTicket[] @relation("PermissionReviewedBy")
  conductedReviews    PerformanceReview[]    @relation("Reviewer")
  attendanceLogs      AttendanceLog[]
  correctionsMade     AttendanceCorrection[] @relation("CorrectionModifier")
  correctionsApproved AttendanceCorrection[] @relation("CorrectionApprover")
  reviewedTrainings EmployeeTraining[] @relation("TrainingReviewer")
  validatedTrainings EmployeeTraining[] @relation("TrainingValidator")

  // ── Ajoute ces deux lignes ici ─────────────────────────────────────────────
  documentsVerified  Document[] @relation("DocumentVerifiedBy")
  documentsUploaded  Document[] @relation("DocumentUploadedBy")

  blogPosts      BlogPost[]
  blogLikes      BlogLike[]

  @@index([email])
  @@index([companyId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ✅ Enum PostgreSQL natif
enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  MANAGER
  EMPLOYEE
  CABINET_ADMIN
  CABINET_GESTIONNAIRE

  @@map("user_role")
}

// ============================================================================
// 2️⃣ ENTREPRISE
// ============================================================================

model Company {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Identité légale
  legalName  String  @db.VarChar(255)
  tradeName  String? @db.VarChar(255)
  rccmNumber String  @unique @db.VarChar(50)
  cnssNumber String? @db.VarChar(50)
  cnssAffiliationNumber  String?  @db.VarChar(50)
  cnssRegisteredAt       DateTime? @db.Date 
  taxNumber  String? @db.VarChar(50)
  legalForm String? @db.VarChar(100) // "SARL", "SA"... — utilisé dans les contrats de prestation
  
  // Coordonnées
  address String  @db.Text
  city    String  @db.VarChar(100)
  country String  @default("CG") @db.Char(2)
  phone   String  @db.VarChar(20)
  email   String  @db.VarChar(255)
  website String? @db.VarChar(255)

  // Branding
  logo           String? @db.Text // URL ou base64
  
  slug           String? @unique @db.VarChar(255)  // ✅
  primaryColor   String  @default("#0EA5E9") @db.Char(7)
  secondaryColor String  @default("#10B981") @db.Char(7)
  cachetUrl        String?          @db.Text // cachet + signature RH, injecté uniquement sur les documents validés
  documentTemplate DocumentTemplate @default(DEFAULT)
  documentFooterText String?          @db.Text

  // Banque
  bankName    String? @db.VarChar(100)
  bankAccount String? @db.VarChar(50)
  bankRib     String? @db.VarChar(30)

  // Configuration
  industry        String?   @db.VarChar(100)
  foundedDate     DateTime? @db.Date
  fiscalYearStart Int       @default(1) @db.SmallInt

  // RH (valeurs par défaut - vraies règles dans PayrollSettings)
  workDaysPerMonth  Int     @default(26) @db.SmallInt
  workHoursPerDay   Decimal @default(8.0) @db.Decimal(4, 2)
  payrollCloseDay   Int     @default(25) @db.SmallInt
  payrollPaymentDay Int     @default(10) @db.SmallInt

  // Géolocalisation
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  allowedRadius Int?     @default(100) @db.SmallInt

  isActive  Boolean  @default(true)
  managedByCabinet Boolean @default(false)
  cabinetId        String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Configuration fiscale entreprise
  appliesCnssEmployer Boolean @default(true)
 cnssEmployerRate  Decimal @default(20.28) @db.Decimal(5, 2)

  // Configuration par défaut pour nouveaux employés
  defaultAppliesIrpp Boolean @default(true)
  defaultAppliesCnss Boolean @default(true)
  isSubjectToTus     Boolean @default(true)  // ← AJOUTER ICI

  // 🆕 Générateur de contrats
  contractRepresentativeName String? @db.VarChar(150)
  contractRepresentativeRole String? @db.VarChar(150)
  contractSignatureCity      String? @db.VarChar(100)
  contractTypesConfig        Json?   // [{ key, label, kind }]

  // 🎨 PERSONNALISATION PAGE CARRIÈRE
  careerPageBanner    String?  @db.Text
  careerPageLogo      String?  @db.Text
  careerPageColors    Json?
  careerPageAbout     String?  @db.Text
  careerPageValues    String[] @default([])
  careerPagePhotos    String[] @default([])
  careerPageCustomCss String?  @db.Text
  // 🆕 CONVENTION COLLECTIVE
  collectiveAgreement String? @db.VarChar(100) // "BTP", "COMMERCE", "BANQUES", null si manuel
  seniorityMode        String   @default("AUTO") @db.VarChar(10)
  // Ancienneté — formule linéaire configurable
  seniorityLinearConfig Json?
  appliesSeniorityLeaveBonus Boolean @default(true)
  echelonReminderEnabled Boolean @default(false)
  leaveConventionKey         String  @default("GENERALE") @db.VarChar(30)
  // Congés — méthode indemnité : AVERAGE_12M (défaut) ou CURRENT_SALARY
  leaveIndemnityMethod String @default("AVERAGE_12M") @db.VarChar(20)
  // Congés — cycle de référence : JANUARY (défaut) / HIRE_DATE / JUNE
  leaveReferenceCycle String @default("JANUARY") @db.VarChar(20)
  // 🆕 RELATION ABONNEMENT (One-to-One)
 subscription Subscription?
 bulletinTemplate BulletinTemplate?

  // 🆕 RELATION PAIEMENTS (One-to-Many - accès direct)
  payments Payment[] @relation("CompanyPayments")

  // Relations existantes
  
  users                 User[]
  employees             Employee[]
  departments           Department[]
  payrolls              Payroll[]
  payrollSettings       PayrollSettings[]
  leaves                Leave[]
  absenceRequests AbsenceRequest[]
  permissionTickets PermissionTicket[]
  attendances           Attendance[]
  publicHolidays        PublicHoliday[]
  documents             Document[]
  jobOffers             JobOffer[]
  trainingCourses       TrainingCourse[]
  assets                Asset[]
   companyDeductions CompanyDeduction[]
  nonWorkingDays        NonWorkingDay[]
  importMappingPatterns ImportMappingPattern[]
  // 🆕 NOUVELLES RELATIONS
  collectiveAgreementRules CollectiveAgreementRule[]
  bonusTemplates           BonusTemplate[]
  companyTaxes             CompanyTax[] 

  contractRuptures ContractRupture[] // ← AJOUTER si absent
  pseProcedures    PSEProcedure[]    // ← AJOUTER

  cabinetCompanies      CabinetCompany[]
  cabinetImportMappings CabinetImportMapping[]
  batchClosureItems     CabinetBatchClosureItem[]
  cnssDeclarations       CnssDeclaration[]
  employeeContracts EmployeeContract[]
  unpaidAlerts      UnpaidSalaryAlert[]
  workShifts            WorkShift[]
  shiftAssignments      EmployeeShiftAssignment[]
  companySites          CompanySite[] 
  blogPosts        BlogPost[]
  blogMonthlyQuota BlogMonthlyQuota[]
  generatedContracts GeneratedContract[]
  echelonSuggestions     EchelonSuggestion[]   // relation inverse
  affiliatedBy     String?           @db.Uuid
  affiliate        Affiliate?        @relation("AffiliateCompanies", fields: [affiliatedBy], references: [id], onDelete: SetNull)
  affiliateCompany AffiliateCompany?

  @@index([appliesCnssEmployer])
  @@index([rccmNumber])
  @@index([isActive])
  @@map("companies")
}

model NonWorkingDay {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dayOfWeek   Int     @db.SmallInt // 0-6
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([companyId, dayOfWeek])
  @@index([companyId])
  @@map("non_working_days")
}

// ============================================================================
// 3️⃣ DÉPARTEMENTS
// ============================================================================

model Department {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @db.VarChar(100)
  code        String? @db.VarChar(20)
  description String? @db.Text
  color       String  @default("#0EA5E9") @db.Char(7)

  managerId String? @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  trainingBudget Decimal? @db.Decimal(15, 2) @map("training_budget")
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  employees Employee[]
  jobOffers JobOffer[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([managerId])
  @@map("departments")
}

// ============================================================================
// 4️⃣ EMPLOYÉS
// ============================================================================

// ============================================================================
// 🔥 MODIFICATION CRITIQUE : CNI/Passeport maintenant OPTIONNEL
// ============================================================================

model Employee {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  employeeNumber String @db.VarChar(50)

  // Identité
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  dateOfBirth  DateTime @db.Date
  placeOfBirth String   @db.VarChar(100)
  gender       Gender

  // 🆕 SITUATION FAMILIALE (pour quotient fiscal IRPP/ITS)
  maritalStatus    MaritalStatus @default(SINGLE)
  numberOfChildren Int           @default(0) @db.SmallInt

  // Contact
// Contact
  phone   String? @unique @db.VarChar(20) // ✅ optionnel + unique
  secondaryPhone String?          @db.VarChar(20)
  email   String @db.VarChar(255)
  address String @db.Text
  city    String @default("Brazzaville") @db.VarChar(100)
  // AJOUT ICI : Zone TOL pour le calcul de la taxe
  tolZone TolZone @default(VILLE)
  // 🆕 FICHE ORCA — Informations complémentaires
  bloodType                String?  @db.VarChar(10)   // Groupe sanguin (A+, O-, etc.)
  pathology                String?  @db.Text          // Pathologie / maladie habituelle
  fatherName               String?  @db.VarChar(150)  // Nom & prénom(s) du père
  motherName               String?  @db.VarChar(150)  // Nom & prénom(s) de la mère
  educationLevel           String?  @db.VarChar(100)  // Niveau d'études / diplôme le plus élevé
  emergencyContactName     String?  @db.VarChar(150)  // Personne à contacter en cas d'urgence
  emergencyContactRelation String?  @db.VarChar(50)   // Lien de parenté
  emergencyContactPhone    String?  @db.VarChar(20)   // Téléphone de la personne à contacter
  hasDrivingLicense        Boolean  @default(false)   // Permis de conduire (Oui/Non)
  drivingLicenseNumber     String?  @db.VarChar(50)   // N° du permis
  foreignLanguages         String?  @db.VarChar(255)  // Langue(s) étrangère(s)
  uniformSize              String?  @db.VarChar(10)   // Taille de la tenue (S/M/L/XL/XXL)
  shoeSize                 String?  @db.VarChar(10)   // Pointure de chaussures

  openingCumulativeGross  Decimal? @db.Decimal(15,2)
  openingCumulativeMonths Int?

  // 🆕 Auto-service — RH/Admin autorise temporairement l'employé à modifier
  // certaines infos de son profil, puis reverrouille une fois validé
  selfServiceEnabled   Boolean   @default(false)
  selfServiceEnabledAt DateTime?
  selfServiceEnabledBy String?   @db.VarChar(150)

  photoUrl String? @db.Text

  // ✅ MODIFICATION : nationalIdNumber maintenant OPTIONNEL
  nationalIdNumber String? @db.VarChar(50) // ✅ Supprimé @unique car optionnel
  cnssNumber       String? @db.VarChar(50) // ✅ Reste optionnel
  taxNumber        String? @db.VarChar(50)
  niu        String? 

  // Emploi
  hireDate        DateTime     @db.Date
  leaveCycleStartDate DateTime? @db.Date
  contractType    ContractType
  contractEndDate DateTime?    @db.Date
  position        String       @db.VarChar(100)

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])

  baseSalary Decimal @db.Decimal(15, 2)

  // Paiement
  bankName            String?       @db.VarChar(100)
  bankAccountNumber   String?       @db.VarChar(50)
  paymentMethod       PaymentMethod @default(BANK_TRANSFER)
  mobileMoneyNumber   String?       @db.VarChar(20)
  mobileMoneyOperator String?       @db.VarChar(50)

  // Statut
  status            EmployeeStatus @default(ACTIVE)
  terminationDate   DateTime?      @db.Date
  terminationReason String?        @db.Text

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  createdById String?  @db.Uuid
  createdBy   User?    @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Régime fiscal individuel (peut override les paramètres entreprise)
  isSubjectToIrpp     Boolean             @default(true) // Soumis à IRPP/ITS ?
  isSubjectToCnss     Boolean             @default(true) // Soumis à CNSS salariale ?
  isSubjectToTus      Boolean             @default(true)  // Soumis à TUS patronale ?
  taxExemptionReason  String?             @db.Text // Justification de l'exemption

  // 🆕 CLASSIFICATION CONVENTION COLLECTIVE
  professionalCategory String? @db.VarChar(50)  // "Cat.3 Éch.4", "A1", etc.
  echelon              String? @db.VarChar(50)  // même valeur que professionalCategory si convention

    // 🆕 PÉRIODE D'ESSAI (CDI / CDD uniquement)
  // Pendant l'essai : paie normale, toutes les charges s'appliquent
  // Rupture possible sans préavis ni indemnités
  trialPeriodDays  Int?          @db.SmallInt       // Durée en jours (ex: 30, 60, 90)
  trialEndDate     DateTime?     @db.Date           // hireDate + trialPeriodDays
  trialConfirmedAt DateTime?     @db.Timestamptz    // Date de confirmation de l'essai
  trialStatus      TrialStatus   @default(NONE)     // NONE | IN_PROGRESS | CONFIRMED | FAILED | EXPIRED

  // 🆕 NATIONALITÉ / RÉSIDENCE (pour calcul BNC Consultant/Prestataire)
  // true = résident congolais → BNC 10% (CGI art. 47 ter)
  // false = étranger non domicilié → BNC 20% (CGI art. 44)
  isResident   Boolean @default(true)
  nationality  String? @db.VarChar(50)  // "CG", "FR", "US"... (ISO 3166-1)


  // ✅ YTD CarryOver — point de départ historique saisi manuellement
  // Débloqué en janvier ou après retour de congé (cycle = 0)
  ytdCarryOverBrut       Decimal?  @db.Decimal(15, 2)
  ytdCarryOverChargesSal Decimal?  @db.Decimal(15, 2)
  ytdCarryOverChargesPat Decimal?  @db.Decimal(15, 2)
  ytdCarryOverDate       DateTime? @db.Date
  ytdCarryOverNetImp     Decimal?  @db.Decimal(15, 2)
  ytdCarryOverNetSalary  Decimal?  @db.Decimal(15, 2)
  // Ancienneté — override personnel (prioritaire sur Company.seniorityLinearConfig)
  seniorityLinearOverride Json?

  // Relations
  user                User?
  payrolls            Payroll[]
  leaves              Leave[]
  leaveBalances       LeaveBalance[]
  absenceRequests AbsenceRequest[]
  permissionTickets PermissionTicket[]
  attendances         Attendance[]
  documents           Document[]
  loans               Loan[]
  advances            Advance[]
   companyDeductions CompanyDeduction[]
  performanceReviews  PerformanceReview[] @relation("Reviewee")
  goals               Goal[]
  trainings           EmployeeTraining[]
  onboardingProcess   OnboardingProcess?
  assets              Asset[]             @relation("AssignedAssets")
  attendanceSummaries AttendanceSummary[]
    // 🆕 NOUVELLE RELATION
  bonuses EmployeeBonus[]
  contracts         EmployeeContract[]
  pseSalaries PSESalarie[] // ← AJOUTER
  cnssDeclarationLines CnssDeclarationLine[]
  shiftAssignments      EmployeeShiftAssignment[]
  contractRuptures ContractRupture[] // <-- À ajouter ici pour boucler la boucle
  ytdCheckpoints YtdCheckpoint[]
  generatedContracts GeneratedContract[]
  echelonSuggestions EchelonSuggestion[]  

  @@unique([employeeNumber, companyId])
  // ✅ SUPPRIMÉ : @@index([nationalIdNumber]) car maintenant optionnel
  @@index([isSubjectToIrpp])
  @@index([isSubjectToCnss])
  @@index([companyId])
  @@index([departmentId])
  @@index([employeeNumber])
  @@index([status])
  @@index([maritalStatus])
  @@index([hireDate])
  @@index([professionalCategory])
  @@map("employees")
}

// ✅ Enums PostgreSQL natifs
enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED

  @@map("marital_status")
}

enum ContractType {
  CDI
  CDD
  STAGE
  CONSULTANT
  INTERIM
  PRESTATAIRE

  @@map("contract_type")
}

enum PaymentMethod {
  BANK_TRANSFER
  CHECK
  CASH
  MOBILE_MONEY

  @@map("payment_method")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RETIRED

  @@map("employee_status")
}
enum TolZone {
  VILLE
  PERIPHERIE

  @@map("tol_zone")
}
enum TrialStatus {
  NONE
  IN_PROGRESS
  CONFIRMED
  FAILED
  EXPIRED
}

// ============================================================================
// 5️⃣ PAIE (CONFORME CONGO 2025-2026)
// ============================================================================

model Payroll {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  month       Int       @db.SmallInt // 1-12
  year        Int       @db.SmallInt
  periodStart DateTime  @db.Date
  periodEnd   DateTime  @db.Date
  paymentDate DateTime? @db.Date

  // ✅ Temps de travail
  workDays    Int     @db.SmallInt
  workedDays  Decimal @db.Decimal(5, 2)
  absenceDays Decimal @db.Decimal(5, 2)
  daysOnLeave Decimal @default(0) @db.Decimal(5, 2)
  daysRemote  Decimal @default(0) @db.Decimal(5, 2)
  daysHoliday Decimal @default(0) @db.Decimal(5, 2)

  // ✅ Heures supplémentaires
normalHours         Decimal @default(0) @db.Decimal(6, 2)
overtimeHours10     Decimal @default(0) @db.Decimal(6, 2)
overtimeHours25     Decimal @default(0) @db.Decimal(6, 2)
overtimeHours50     Decimal @default(0) @db.Decimal(6, 2)
overtimeHours100    Decimal @default(0) @db.Decimal(6, 2)

  // ✅ Montants heures sup
overtimeAmount10    Decimal @default(0) @db.Decimal(15, 2)
overtimeAmount25    Decimal @default(0) @db.Decimal(15, 2)
overtimeAmount50    Decimal @default(0) @db.Decimal(15, 2)
overtimeAmount100   Decimal @default(0) @db.Decimal(15, 2)
totalOvertimeAmount Decimal @default(0) @db.Decimal(15, 2)

  // ✅ Décomposition salaire
  baseSalary         Decimal  @db.Decimal(15, 2)
  adjustedBaseSalary Decimal? @db.Decimal(15, 2)
  absenceDeduction   Decimal  @default(0) @db.Decimal(15, 2)
  totalBonuses       Decimal  @default(0) @db.Decimal(15, 2)

  // Montants finaux
  grossSalary       Decimal @db.Decimal(15, 2)
  netSalary         Decimal @db.Decimal(15, 2)
  totalDeductions   Decimal @db.Decimal(15, 2)
  totalEmployerCost Decimal @db.Decimal(15, 2)

  // ✅ Taxes & Charges
  cnssSalarial Decimal @default(0) @db.Decimal(15, 2)
  cnssEmployer Decimal @default(0) @db.Decimal(15, 2)
  its          Decimal @default(0) @db.Decimal(15, 2) // IRPP 2025 / ITS 2026

  // ✅ CNSS Patronale 3 branches (Décret n°99-284)
cnssEmployerPension   Decimal @default(0) @db.Decimal(15, 2)  // 8,00%  / plafond 1 200 000
cnssEmployerFamily    Decimal @default(0) @db.Decimal(15, 2)  // 10,03% / plafond   600 000
cnssEmployerAccident  Decimal @default(0) @db.Decimal(15, 2)  // 2,25%  / plafond   600 000

// ✅ TUS
tusDgiAmount          Decimal @default(0) @db.Decimal(15, 2)  // 4,13% → versé DGI
tusCnssAmount         Decimal @default(0) @db.Decimal(15, 2)  // 3,38% → versé CNSS
tusTotal              Decimal @default(0) @db.Decimal(15, 2)  // 7,51% total patronal

// À ajouter dans model Payroll, après tusTotal :
employeeCustomTaxTotal  Decimal @default(0) @db.Decimal(15, 2)
employerCustomTaxTotal  Decimal @default(0) @db.Decimal(15, 2)

  // 🆕 DÉTAILS IRPP/ITS (pour audit et conformité)
  irppAbattement    Decimal @default(0) @db.Decimal(15, 2)
  irppFiscalParts   Decimal @default(1) @db.Decimal(3, 1)
  irppEffectiveRate Decimal @default(0) @db.Decimal(5, 2)

  // Workflow
  status    PayrollStatus @default(DRAFT)
  validated Boolean       @default(false)

  validatedBy     String?   @db.Uuid
  validatedAt     DateTime? @db.Timestamptz
  validatedByUser User?     @relation("PayrollValidatedBy", fields: [validatedBy], references: [id], onDelete: SetNull)

