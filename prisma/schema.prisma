 }


model BonusMonthlyQuantity {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 
  employeeBonusId  String        @db.Uuid
  employeeBonus    EmployeeBonus @relation(fields: [employeeBonusId], references: [id], onDelete: Cascade)
 
  month            Int           @db.SmallInt   // 1-12
  year             Int           @db.SmallInt   // ex: 2026
 
  /// Quantité saisie (ex: 7 repas, 3 déplacements, 5 opérations)
  quantity         Decimal       @db.Decimal(8, 2)
 
  /// Montant pré-calculé = unitAmount × quantity (stocké pour audit)
  computedAmount   Decimal       @db.Decimal(15, 2)
 
  /// Note optionnelle (ex: "7 repas pris en avril")
  note             String?       @db.VarChar(200)
 
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt      @db.Timestamptz
 
  @@unique([employeeBonusId, month, year])
  @@index([employeeBonusId])
  @@map("bonus_monthly_quantities")
}
// ============================================================================
// 💼 TAXES & COTISATIONS CONFIGURABLES PAR ENTREPRISE
// ============================================================================

model CompanyTax {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Identité
  name        String  @db.VarChar(100)  // "TOL", "CAMU", "Taxe apprentissage"
  code        String  @db.VarChar(20)   // "TOL", "CAMU", "TAX_APP"
  description String? @db.Text

  // Taux — salarié
  employeeRate  Decimal @default(0) @db.Decimal(6, 4)   // ex: 0.0100 = 1%
  fixedEmployee Decimal @default(0) @db.Decimal(15, 2)  // ex: 1000 = TOL fixe

  // Taux — employeur
  employerRate  Decimal @default(0) @db.Decimal(6, 4)   // ex: 0.0100 = 1%
  fixedEmployer Decimal @default(0) @db.Decimal(15, 2)

  // Base de calcul
  baseType   CompanyTaxBase @default(GROSS)
  hasCeiling Boolean        @default(false)
  ceiling    Decimal?       @db.Decimal(15, 2)
  
    minSalaryThreshold Decimal? @db.Decimal(15, 2)
  // ELIGIBILITY (défaut) = filtre binaire : taxe ignorée si brut < seuil
  // EXCESS_ONLY           = taxe sur l'excédent : base = max(0, base − seuil)
  //                         ex CAMU solidarité : (BI − 500 000) × 0,5%
    thresholdType CompanyTaxThreshold @default(ELIGIBILITY)

  // Activation
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([companyId])
  @@index([isActive])
  @@index([code])
  @@map("company_taxes")
}

enum CompanyTaxThreshold {
  ELIGIBILITY  // Filtre binaire : taxe ignorée si brut < seuil (défaut)
  EXCESS_ONLY  // Taxe sur l'excédent : base = max(0, base − seuil)
}

enum CompanyTaxBase {
  GROSS          // Brut total
  TAXABLE        // SBT (brut − CNSS)
  NET_IMPOSABLE  // RNI (après abattement)
  FIXED          // Montant fixe (ex: TOL = 1 000 F)

  @@map("company_tax_base")
}

